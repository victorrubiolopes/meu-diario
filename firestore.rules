// Regras do Firestore para o projeto "diariorubiofitness".
// Não são aplicadas automaticamente por este repositório (não há deploy via CLI aqui) —
// cole este conteúdo em Firebase Console → Firestore Database → aba Rules → Publicar.
//
// Modelo: cada paciente pertence a uma nutri (profiles/{uid}.nutriId). O dono do app
// (admins/{uid}.super == true) vê todos os pacientes de todas as nutris; uma nutri comum
// só vê quem ela convidou (vínculo criado via link de convite, não editável pelo paciente).

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function ehAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function ehSuperAdmin() {
      return ehAdmin() &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.get('super', false) == true;
    }
    function nutriDoPaciente(patientId) {
      return ehAdmin() && !ehSuperAdmin() &&
        get(/databases/$(database)/documents/profiles/$(patientId)).data.get('nutriId', '') == request.auth.uid;
    }
    function podeAcessarPaciente(patientId) {
      return request.auth.uid == patientId || ehSuperAdmin() || nutriDoPaciente(patientId);
    }

    match /users/{userId} {
      allow read:  if request.auth != null && podeAcessarPaciente(userId);
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /profiles/{userId} {
      allow get:    if request.auth != null && podeAcessarPaciente(userId);
      // Listagem é caso à parte: numa query o Firestore não avalia documento por
      // documento, ele precisa provar pelas restrições da query que todo resultado é
      // permitido. Por isso aqui tem que ser `resource.data.nutriId` (que casa com o
      // where('nutriId','==',uid) do cliente) e não um get() no próprio documento —
      // com get() a query inteira é recusada pra nutri comum.
      allow list:   if request.auth != null && (
        ehSuperAdmin()
        || (ehAdmin() && resource.data.get('nutriId', '') == request.auth.uid)
      );
      allow create: if request.auth != null && request.auth.uid == userId;
      // nutriId é travado pro próprio paciente (não pode se reatribuir sozinho);
      // super-admin pode corrigir só esse campo (reatribuir a outra nutri).
      allow update: if request.auth != null && (
        (request.auth.uid == userId
          && request.resource.data.get('nutriId', null) == resource.data.get('nutriId', null))
        || (ehSuperAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nutriId', 'updatedAt']))
      );
    }

    match /prescricoes/{userId} {
      allow read:  if request.auth != null && podeAcessarPaciente(userId);
      allow write: if request.auth != null && (ehSuperAdmin() || nutriDoPaciente(userId));
    }

    match /admins/{userId} {
      allow read:  if request.auth != null;
      // O papel de profissional É a existência deste documento. Antes só dava pra criar
      // pelo Console; agora o super-admin promove/remove pela própria tela de pacientes.
      // Três travas, todas necessárias mesmo com a UI escondendo os botões (regra é o
      // que vale, UI é conveniência):
      //  1. não pode mexer no próprio documento — auto-rebaixar deixaria o app sem
      //     ninguém capaz de promover, e não há como desfazer sem o Console;
      //  2. não pode criar outro super pelo app — super continua só via Console;
      //  3. não pode alterar nem apagar quem já é super.
      allow create: if ehSuperAdmin()
        && userId != request.auth.uid
        && request.resource.data.get('super', false) == false;
      allow update: if ehSuperAdmin()
        && userId != request.auth.uid
        && request.resource.data.get('super', false) == false
        && resource.data.get('super', false) == false;
      allow delete: if ehSuperAdmin()
        && userId != request.auth.uid
        && resource.data.get('super', false) == false;
    }

    match /inviteCodes/{code} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null && ehAdmin() && request.resource.data.nutriUid == request.auth.uid;
      allow update: if request.auth != null && ehAdmin() && resource.data.nutriUid == request.auth.uid;
      allow delete: if false;
    }

    match /pendingVideos/{doc} {
      allow read:   if ehSuperAdmin();
      allow create: if request.auth != null;
      allow delete: if ehSuperAdmin();
    }
    match /pendingRecipes/{doc} {
      allow read:   if ehSuperAdmin();
      allow create: if request.auth != null;
      allow delete: if ehSuperAdmin();
    }
    // ---- Caixa de entrada de refeições ----
    // Um agente externo (uma conta de login dedicada, criada só pra isso) DEPOSITA aqui
    // refeições já calculadas; o app do dono lê, lança no diário e apaga o documento.
    //
    // O ponto do desenho: o agente NÃO TEM 'allow read' em lugar nenhum. Ele deposita e
    // não enxerga. Se a credencial dele vazar, o estrago é inserir refeição indevida na
    // caixa de alguém — chato, visível no sino e desfazível — e não ler diário, medidas
    // ou exames. Por isso os dados do diário continuam fora do alcance dele: 'users/{uid}'
    // segue gravável só pelo próprio dono, como sempre foi.
    //
    // TROQUE o UID abaixo pelo da conta do agente (Firebase Console → Authentication).
    // Enquanto estiver com o valor de exemplo, ninguém consegue depositar nada — que é o
    // comportamento certo pra uma regra ainda não configurada.
    function ehAgente() {
      return request.auth != null
        && request.auth.uid == 'COLE_AQUI_O_UID_DA_CONTA_DO_AGENTE';
    }
    match /caixaEntrada/{doc} {
      // Só o dono lê e limpa a própria caixa. Nem admin, nem nutri, nem o agente.
      allow read, delete: if request.auth != null && request.auth.uid == resource.data.uid;
      // Depósito: campos fixos e tamanho limitado, pra uma credencial vazada não conseguir
      // usar a coleção como armazenamento livre nem entupir o diário de uma vez.
      allow create: if ehAgente()
        && request.resource.data.keys().hasOnly(['uid', 'date', 'mealType', 'itens', 'criadoEm', 'origem'])
        && request.resource.data.uid is string
        && request.resource.data.date is string
        && request.resource.data.mealType is string
        && request.resource.data.itens is list
        && request.resource.data.itens.size() > 0
        && request.resource.data.itens.size() <= 40;
      // Depósito não se edita: o que foi escrito é o que o dono vai ver.
      allow update: if false;
    }

    match /sharedFoods/{doc}     { allow read, write: if request.auth != null; }
    match /sharedExercises/{doc} { allow read, write: if request.auth != null; }
  }
}
